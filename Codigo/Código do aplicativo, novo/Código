}

// ======================================================
// MODELO DOS COMANDOS
// ======================================================

class Comando {
  final String nome;
  final IconData icone;
  final Color cor;

  Comando({
    required this.nome,
    required this.icone,
    required this.cor,
  });
}

// ======================================================
// BLOCO DE COMANDO
// ======================================================

class BlocoComando extends StatelessWidget {
  final Comando comando;
  final double altura;

  const BlocoComando({
    super.key,
    required this.comando,
    required this.altura,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      height: altura,
      padding: const EdgeInsets.symmetric(
        horizontal: 15,
      ),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(15),
        border: Border.all(
          color: const Color(0xFFE6E6E6),
        ),
      ),
      child: Row(
        children: [

          Container(
            width: 65,
            height: 65,
            decoration: BoxDecoration(
              color: comando.cor,
              borderRadius: BorderRadius.circular(15),
            ),
            child: Icon(
              comando.icone,
              size: 38,
              color: Colors.black87,
            ),
          ),

          const SizedBox(width: 18),

          Expanded(
            child: Text(
              comando.nome,
              style: const TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.w500,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

