class FluxoPage extends StatefulWidget {
  const FluxoPage({super.key});

  @override
  State<FluxoPage> createState() => _FluxoPageState();
}

class _FluxoPageState extends State<FluxoPage> {
  final List<Comando> fluxo = [
    Comando(
      nome: 'Frente',
      icone: Icons.arrow_forward,
      cor: const Color(0xFFDDF5D2),
    ),
  ];

  final List<Comando> comandos = [
    Comando(
      nome: 'Frente',
      icone: Icons.arrow_forward,
      cor: const Color(0xFFDDF5D2),
    ),
    Comando(
      nome: 'Virar Esquerda',
      icone: Icons.arrow_back,
      cor: const Color(0xFFFFE5B5),
    ),
    Comando(
      nome: 'Virar Direita',
      icone: Icons.arrow_upward,
      cor: const Color(0xFFD8E7FF),
    ),
    Comando(
      nome: 'Fim',
      icone: Icons.arrow_downward,
      cor: const Color(0xFFE5D4FF),
    ),
    Comando(
      nome: 'Repetir',
      icone: Icons.repeat,
      cor: const Color(0xFFFFD8D8),
    ),
    Comando(
      nome: 'Variável',
      icone: Icons.data_object,
      cor: const Color(0xFFD4E9FF),
    ),
    Comando(
      nome: 'Se',
      icone: Icons.alt_route,
      cor: const Color(0xFFFFE0A8),
    ),
    Comando(
      nome: 'Senão',
      icone: Icons.call_split,
      cor: const Color(0xFFFFD2A8),
    ),
  ];

  void adicionarComando(Comando comando) {
    setState(() {
      fluxo.add(comando);
    });
  }

  void removerComando(int index) {
    setState(() {
      fluxo.removeAt(index);
    });
  }

  void executar() {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Programa executado! 🤖',
          style: TextStyle(fontSize: 16),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0,
        title: const Text(
          'Fluxo',
          style: TextStyle(
            color: Colors.black,
            fontSize: 26,
            fontWeight: FontWeight.w500,
          ),
        ),
        leading: IconButton(
          icon: const Icon(
            Icons.menu,
            color: Colors.black,
            size: 30,
          ),
          onPressed: () {},
        ),
        actions: [
          const Center(
            child: Text(
              'LOCO: LX',
              style: TextStyle(
                color: Colors.black,
                fontSize: 18,
              ),
            ),
          ),
          IconButton(
            icon: const Icon(
              Icons.keyboard_arrow_down,
              color: Colors.black,
            ),
            onPressed: () {},
          ),
          const SizedBox(width: 15),
        ],
      ),

      body: Column(
        children: [
          Expanded(
            child: Row(
              children: [

                // ==============================
                // MENU DE COMANDOS
                // ==============================

                Container(
                  width: 280,
                  margin: const EdgeInsets.all(18),
                  padding: const EdgeInsets.all(15),
                  decoration: BoxDecoration(
                    color: const Color(0xFFF5F6F8),
                    borderRadius: BorderRadius.circular(18),
                    border: Border.all(
                      color: const Color(0xFFE2E3E5),
                    ),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Padding(
                        padding: EdgeInsets.all(10),
                        child: Text(
                          'Comandos',
                          style: TextStyle(
                            fontSize: 22,
                            fontWeight: FontWeight.w500,
                          ),
                        ),
                      ),

                      Expanded(
                        child: ListView.builder(
                          itemCount: comandos.length,
                          itemBuilder: (context, index) {
                            final comando = comandos[index];

                            return Padding(
                              padding: const EdgeInsets.only(
                                bottom: 10,
                              ),
                              child: GestureDetector(
                                onTap: () {
                                  adicionarComando(comando);
                                },
                                child: BlocoComando(
                                  comando: comando,
                                  altura: 95,
                                ),
                              ),
                            );
                          },
                        ),
                      ),

                      // APAGAR
                      SizedBox(
                        width: double.infinity,
                        height: 60,
                        child: ElevatedButton.icon(
                          onPressed: () {
                            setState(() {
                              fluxo.clear();
                            });
                          },
                          icon: const Icon(Icons.delete_outline),
                          label: const Text(
                            'Apagar',
                            style: TextStyle(fontSize: 18),
                          ),
                          style: ElevatedButton.styleFrom(
                            backgroundColor:
                                const Color(0xFFE8E9EB),
                            foregroundColor: Colors.black87,
                            elevation: 0,
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(15),
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),

                // ==============================
                // ÁREA DO FLUXO
                // ==============================

                Expanded(
                  child: Container(
                    margin: const EdgeInsets.only(
                      top: 20,
                      right: 20,
                      bottom: 20,
                    ),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(20),
                      border: Border.all(
                        color: const Color(0xFFE5E5E5),
                      ),
                    ),
                    child: Column(
                      children: [

                        const SizedBox(height: 25),

                        const Text(
                          'INÍCIO',
                          style: TextStyle(
                            fontSize: 22,
                            fontWeight: FontWeight.w600,
                          ),
                        ),

                        const SizedBox(height: 20),

                        Expanded(
                          child: ListView(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 40,
                            ),
                            children: [

                              // BLOCO INÍCIO
                              const Center(
                                child: BlocoInicio(),
                              ),

                              const Seta(),

                              // FLUXO
                              ...List.generate(
                                fluxo.length,
                                (index) {
