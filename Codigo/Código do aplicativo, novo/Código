// ======================================================
// MENU INFERIOR
// ======================================================

class MenuInferior extends StatelessWidget {
  final IconData icone;
  final String texto;
  final bool selecionado;
  final VoidCallback onTap;

  const MenuInferior({
    super.key,
    required this.icone,
    required this.texto,
    this.selecionado = false,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      child: SizedBox(
        width: 150,
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [

            Icon(
              icone,
              size: 30,
              color: selecionado
                  ? const Color(0xFF1769AA)
                  : Colors.black54,
            ),

            const SizedBox(height: 7),

            Text(
              texto,
              style: TextStyle(
                fontSize: 16,
                color: selecionado
                    ? const Color(0xFF1769AA)
                    : Colors.black54,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
